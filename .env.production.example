# ============================================================
# SolveNow — Production Environment Template
# ============================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.
# ============================================================

# --- Application ---
ENVIRONMENT=production
PROJECT_NAME=SolveNow
API_V1_STR=/api/v1

# SECRET_KEY: Must be a cryptographically random 64+ character string.
# Generate with: openssl rand -hex 64
SECRET_KEY=CHANGEME_openssl_rand_hex_64

# Access token lifetime in minutes (recommend 15 for high-security, 60 for normal)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=solvenow
POSTGRES_PASSWORD=CHANGEME_strong_postgres_password
POSTGRES_DB=solvenow_production

# Connection pooling (tune based on server resources; default suitable for 2-4 CPU VPS)
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_PRE_PING=true

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Set a strong password for production Redis
REDIS_PASSWORD=CHANGEME_strong_redis_password
# Full Redis URL (takes precedence over host/port/password if set)
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- Object Storage (S3-compatible) ---
# Works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=CHANGEME_access_key
S3_SECRET_ACCESS_KEY=CHANGEME_secret_key
S3_BUCKET_NAME=solvenow-files-production
S3_REGION=us-east-1
# Presigned URL expiration in seconds (3600 = 1 hour)
S3_PRESIGNED_URL_EXPIRY=3600

# --- Frontend / API URLs ---
# Must be full HTTPS URLs in production — no localhost
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# --- AI Provider ---
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_api_key_here


# --- Monitoring ---
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# --- Worker (Celery) ---
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
CELERY_CONCURRENCY=4

# --- Email (for notifications — optional) ---
# Leave SMTP_HOST empty to disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# --- Docker image tags (used by deploy workflow) ---
# Set to the git SHA or semver tag during CI/CD
IMAGE_TAG=latest

